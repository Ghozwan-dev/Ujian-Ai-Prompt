{
  "name": "project-barang-temuan",
  "version": "1.0.0",
  "description": "Aplikasi Web Barang Temuan & Barang Hilang",
  "main": "index.html",
  "scripts": {
    "build": "node build.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=path.join(__dirname,req.url==='/'?'index.html':req.url.split('?')[0]);if(fs.existsSync(f)&&fs.statSync(f).isFile()){const ext=path.extname(f);const m={'.html':'text/html','.css':'text/css','.js':'application/javascript','.png':'image/png','.jpg':'image/jpeg','.svg':'image/svg+xml'};res.writeHead(200,{'Content-Type':m[ext]||'text/plain'});fs.createReadStream(f).pipe(res);}else{res.writeHead(404);res.end('Not Found');}}).listen(3000,()=>console.log('Server running at http://localhost:3000'));\"",
    "dev": "npm start",
    "web": "npm start",
    "test": "node build.js"
  },
  "keywords": [
    "barang-temuan",
    "lost-and-found",
    "ujian-ai-prompt"
  ],
  "author": "",
  "license": "ISC"
}
